<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚙️ 默认时薪设置" android:textSize="20sp" android:textStyle="bold"
            android:textColor="#333" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="正常工作日时薪（元/小时）" android:textSize="13sp" android:textColor="#666"/>
        <EditText android:id="@+id/et_normal_rate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:hint="例: 20" android:textSize="16sp"
            android:layout_marginBottom="14dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="周末时薪（元/小时）" android:textSize="13sp" android:textColor="#666"/>
        <EditText android:id="@+id/et_weekend_rate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:hint="例: 30" android:textSize="16sp"
            android:layout_marginBottom="14dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="节假日时薪（元/小时）" android:textSize="13sp" android:textColor="#666"/>
        <EditText android:id="@+id/et_holiday_rate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:hint="例: 50" android:textSize="16sp"
            android:layout_marginBottom="14dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="自定义节假日（每行一个，格式: 2026-05-01）" android:textSize="13sp" android:textColor="#666"/>
        <EditText android:id="@+id/et_holidays"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textMultiLine" android:minLines="3" android:hint=""
            android:textSize="14sp" android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <Button android:id="@+id/btn_cancel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="取消" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <Button android:id="@+id/btn_save"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="保存"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
